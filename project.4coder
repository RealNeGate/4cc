version(1);
project_name = "4coder";

patterns = {
  "*.c",
  "*.cpp",
  "*.hpp",
  "*.h",
  "*.m",
  "*.bat",
  "*.sh",
  "*.4coder",
};

blacklist_patterns = {
  ".*", "tests"
};

load_paths_custom = {
 {"."}, {"../4coder_byp"}
};

load_paths = {
  { load_paths_custom, .os = "win"  },
  { load_paths_custom, .os = "linux"},
  { load_paths_custom, .os = "mac"  },
};

command_list = {
  {
    .name = "build",
    .out = "*compilation*", .footer_panel = true, .save_dirty_files = true, .cursor_at_end = true,
    .cmd = { {"./bin/build.bat", .os = "win" }, },
  },
  {
    .name = "debug",
    .out = "*compilation*", .footer_panel = true, .save_dirty_files = true, .cursor_at_end = true,
    .cmd = { {"remedybg foo.rdbg", .os = "win" }, },
  },
};

fkey_command[1] = "build";
fkey_command[3] = "debug";

